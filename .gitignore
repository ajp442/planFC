__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# Logs and local database files
*.log
db.sqlite3
