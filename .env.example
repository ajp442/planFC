# Copy to .env beside compose.yaml and set real secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
POSTGRES_PASSWORD=change-me-too

# Every hostname the site is reached by. A leading dot matches any subdomain,
# which is what makes the randomly named quick tunnels usable without editing
# this file on every run.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://*.trycloudflare.com

# Everything below is optional; the values shown are the defaults.

# Pin a release (e.g. 0.1.0) instead of tracking the newest.
# PLANFC_VERSION=latest

# A domain name here makes Caddy fetch a Let's Encrypt certificate; it then
# needs HTTP_PORT=80 and HTTPS_PORT=443, and the domain must resolve to this host.
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443

# POSTGRES_DB=planfc
# POSTGRES_USER=planfc

# --- Accounts. docs/ACCOUNTS.md explains where each value comes from. ---

# 1 once the site is served over HTTPS (a real domain or a tunnel): session
# cookies are then never sent over plain HTTP. Leave at 0 for
# http://localhost, or signing in stops working.
# DJANGO_HTTPS=0

# Sign-up needs a confirmed email address. Without EMAIL_HOST, emails are
# printed to `docker compose logs web` instead of sent.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=planFC <noreply@myplanfc.com>

# "Continue with Google". The button appears once the client ID is set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# "Continue with Apple". Needs a paid Apple Developer membership. The key is
# the .p8 file's contents on one line, with each line break written as \n.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Push notifications. Generate once and never change, or every member's
# devices stop receiving them:
#   docker compose run --rm web python manage.py generate_vapid_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Dev only (compose.override.yaml): the host user's uid (`id -u`), so the
# container can write into the bind-mounted source tree.
# APP_UID=1000
