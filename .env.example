# Copy to .env beside compose.yaml and set real secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
POSTGRES_PASSWORD=change-me-too

# Every hostname the site is reached by. A leading dot matches any subdomain,
# which is what makes the randomly named quick tunnels usable without editing
# this file on every run.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://*.trycloudflare.com

# Everything below is optional; the values shown are the defaults.

# Pin a release (e.g. 0.1.0) instead of tracking the newest.
# PLANFC_VERSION=latest

# A domain name here makes Caddy fetch a Let's Encrypt certificate; it then
# needs HTTP_PORT=80 and HTTPS_PORT=443, and the domain must resolve to this host.
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443

# POSTGRES_DB=planfc
# POSTGRES_USER=planfc

# Dev only (compose.override.yaml): the host user's uid (`id -u`), so the
# container can write into the bind-mounted source tree.
# APP_UID=1000
