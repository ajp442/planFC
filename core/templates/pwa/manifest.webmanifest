{% load static %}{
  "name": "{{ app_name }}",
  "short_name": "{{ app_name }}",
  "description": "Pickup game planning for our football club.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f1412",
  "theme_color": "{{ theme_color }}",
  "icons": [
    {
      "src": "{% static icon_dir|add:'icon_192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static icon_dir|add:'icon_512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static icon_dir|add:'icon_maskable_512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
